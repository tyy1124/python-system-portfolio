# 請複製為 linkset.env 後填入自己的設定
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret

# TDX API
CLIENT_ID=your-tdx-client-id
CLIENT_SECRET=your-tdx-client-secret

# Gmail SMTP（若不使用寄信功能可留空）
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

# Cloudinary（若不使用大頭貼上傳可留空）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# 或使用 CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Database（未設定時本機預設使用 SQLite）
# DATABASE_URL=
# JAWSDB_MARIA_URL=

# Optional
LEGAL_CONTACT_EMAIL=your-email@example.com
AUTO_CREATE_DB=1


# Demo account（公開作品展示用途，不是私人帳密）
DEMO_ENABLED=1
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234
DEMO_NAME=作品展示帳號
DEMO_EMAIL=demo@example.com
